---
import DemoFrame from "./DemoFrame.astro";
---
<DemoFrame name="screenshots" label="Capture a little bit" status="Just the useful bit.">
	<div class="capture-scene" aria-hidden="true">
		<span class="scene-sun"></span>
		<span class="scene-hill scene-hill-back"></span>
		<span class="scene-hill scene-hill-front"></span>
		<span class="capture-frame"><span class="hand capture-label">A good bit, kept.</span></span>
		<span class="capture-flash"></span>
		<span class="capture-thumb"></span>
	</div>
</DemoFrame>

<script>
	import { SHEET_CLOSED } from "../../scripts/sheet-events";
	import { reduceMotion } from "../../scripts/spring";
	import { type DemoParts, findDemo } from "./demo";

	function setUp({ root, button, status, sheet }: DemoParts) {
		const scene = root.querySelector<HTMLElement>(".capture-scene");
		const flash = root.querySelector<HTMLElement>(".capture-flash");
		if (!scene || !flash) return;
		const start = { button: button.textContent, status: status.textContent };
		const show = (captured: boolean) => {
			scene.classList.toggle("is-captured", captured);
			button.textContent = captured ? "Try another" : start.button;
			status.textContent = captured ? "Captured and copied!" : start.status;
		};
		button.addEventListener("click", () => {
			const captured = !scene.classList.contains("is-captured");
			show(captured);
			if (captured && !reduceMotion.matches) {
				flash.animate([{ opacity: 0 }, { opacity: 0.85 }, { opacity: 0 }], {
					duration: 320,
					easing: "ease-out",
				});
			}
		});
		sheet.addEventListener(SHEET_CLOSED, () => show(false));
	}

	const demo = findDemo("screenshots");
	if (demo) setUp(demo);
</script>

<style>
	.capture-scene {
		position: relative;
		height: 7.5rem;
		overflow: hidden;
		background: #e2eaf1;
		border-radius: 2px;
	}
	.scene-sun {
		position: absolute;
		top: 1.1rem;
		right: 23%;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		background: #e5c784;
	}
	.scene-hill {
		position: absolute;
	}
	.scene-hill-back {
		top: 2.3rem;
		left: 0.6rem;
		width: 9rem;
		height: 9rem;
		background: #abc5b2;
		border-radius: 45% 60% 0 0;
		transform: rotate(-26deg);
	}
	.scene-hill-front {
		top: 2.6rem;
		right: -0.6rem;
		width: 9.5rem;
		height: 8rem;
		background: #c3d3c0;
		border-radius: 70% 30% 0 0;
		transform: rotate(10deg);
	}
	.capture-frame {
		position: absolute;
		inset: 0.8rem 2rem 1.4rem;
		z-index: 3;
		border: 1.5px dashed #b72d48;
		opacity: 0;
		transform: scale(0.82);
		transition:
			transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.2s ease;
	}
	.capture-label {
		position: absolute;
		left: 0.8rem;
		bottom: -0.75rem;
		padding: 0 0.4rem;
		font-size: 1.15rem;
		line-height: 1.2;
		white-space: nowrap;
		color: #9a2e45;
		background: #fffefb;
	}
	.capture-flash {
		position: absolute;
		inset: 0;
		z-index: 4;
		background: #ffffff;
		opacity: 0;
		pointer-events: none;
	}
	.capture-thumb {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		z-index: 5;
		width: 3.75rem;
		aspect-ratio: 4 / 3;
		background: linear-gradient(162deg, #e2eaf1 0 42%, #abc5b2 42% 70%, #c3d3c0 70%);
		border: 2px solid #ffffff;
		border-radius: 3px;
		box-shadow: 0 3px 8px #00000033;
		opacity: 0;
		transform: translate(30%, 30%) scale(0.7) rotate(6deg);
		transition:
			transform 0.45s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.25s 0.3s ease;
	}
	.is-captured .capture-frame {
		opacity: 1;
		transform: none;
	}
	.is-captured .capture-thumb {
		opacity: 1;
		transform: rotate(-3deg);
	}
</style>
