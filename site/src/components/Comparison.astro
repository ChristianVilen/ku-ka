---
import { tools } from "../data/tools";
---
<section class="section split page-width" aria-labelledby="comparison-heading">
	<div class="section-heading">
		<p class="hand kicker">honest labels</p>
		<h2 id="comparison-heading">One app instead of five.</h2>
		<p>A few useful tools together, with clear limits.</p>
	</div>
	<table class="limits-table">
		<thead><tr><th scope="col">The tool</th><th scope="col">What to expect</th></tr></thead>
		<tbody>
			{tools.map((tool) => (
				<tr>
					<th scope="row"><span class="tool-label"><span class="tool-dot" style={`--tool-color: ${tool.color}`} aria-hidden="true"></span><span>{tool.name}</span></span></th>
					<td>{tool.limit}</td>
				</tr>
			))}
		</tbody>
	</table>
</section>

<style>
	.limits-table {
		width: 100%;
		border-collapse: collapse;
	}
	th,
	td {
		padding: 1rem 1rem 1rem 0;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--rule);
	}
	thead th {
		padding-top: 0;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--ink-soft);
	}
	tbody th {
		width: 34%;
		font-weight: 600;
	}
	td {
		color: var(--ink-soft);
	}
	.tool-label {
		display: inline-flex;
		align-items: flex-start;
		gap: 0.65rem;
	}
	.tool-dot {
		flex: none;
		width: 0.6rem;
		height: 0.6rem;
		margin-top: 0.5em;
		border-radius: 50%;
		background: var(--tool-color);
	}
	@media (max-width: 760px) {
		tbody th {
			width: 40%;
		}
	}
	@media (max-width: 480px) {
		.limits-table {
			font-size: 0.925rem;
		}
		th,
		td {
			padding-right: 0.75rem;
		}
	}
</style>
