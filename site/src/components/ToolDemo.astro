---
import type { ToolId } from "../data/tools";

interface Props {
	id: ToolId;
}
const { id } = Astro.props;

// Without "on" words the button does one action each time, and the script writes the status.
const controls: Record<
	ToolId,
	{ label: string; onLabel?: string; status: string; onStatus?: string }
> = {
	screenshots: {
		label: "Capture a little bit",
		onLabel: "Try another",
		status: "Just the useful bit.",
		onStatus: "Captured and copied!",
	},
	clipboard: { label: "Paste an older one", status: "Never far away." },
	windows: {
		label: "Give it more room",
		onLabel: "Two windows again",
		status: "Nice and tidy.",
		onStatus: "All the room it needs.",
	},
	awake: {
		label: "Keep it awake",
		onLabel: "Let it rest",
		status: "Take your time.",
		onStatus: "Wide awake.",
	},
	meetings: {
		label: "Keep a note",
		onLabel: "Clear the note",
		status: "Stay in the conversation.",
		onStatus: "Noted.",
	},
};
const control = controls[id];
---
<div class={`mini-demo demo-${id}`} data-demo={id}>
	{id === "screenshots" && (
		<div class="capture-scene" aria-hidden="true">
			<span class="scene-sun"></span>
			<span class="scene-hill scene-hill-back"></span>
			<span class="scene-hill scene-hill-front"></span>
			<span class="capture-frame"><span class="hand capture-label">A good bit, kept.</span></span>
			<span class="capture-flash"></span>
			<span class="capture-thumb"></span>
		</div>
	)}
	{id === "clipboard" && (
		<ol class="clip-stack" aria-label="Copied earlier">
			<li class="hand">The link you meant to keep.</li>
			<li class="hand">An idea worth another look.</li>
			<li class="hand">That thing you just copied.</li>
		</ol>
	)}
	{id === "windows" && (
		<div class="tiny-desktop" aria-hidden="true">
			<div class="tiny-window"><span></span><span></span><span></span></div>
			<div class="tiny-window tiny-window-blue"><span></span><span></span></div>
		</div>
	)}
	{id === "awake" && (
		<div class="awake-scene">
			<div class="awake-dial" aria-hidden="true">
				<svg viewBox="0 0 80 80" focusable="false"><circle class="dial-track" cx="40" cy="40" r="34" /><circle class="dial-ring" cx="40" cy="40" r="34" pathLength="100" /></svg>
				<span class="hand dial-time" data-dial>1h</span>
				<span class="hand dial-zzz">z z z</span>
			</div>
			<p class="awake-text"><strong>A little longer.</strong>Your build can finish. You can get a coffee.</p>
		</div>
	)}
	{id === "meetings" && (
		<div class="meeting-scene">
			<div class="meeting-bar" aria-hidden="true"><span class="rec-dot"></span>Recording<span class="rec-time">12:34</span></div>
			<div class="meeting-transcript">
				<p><strong>Me</strong> <span>12:10</span> Let's keep the simpler version.</p>
				<p><strong>Them</strong> <span>12:18</span> I'll send the sketch today.</p>
			</div>
			<p class="hand meeting-note" data-note data-on-note="12:25 Keep the simpler version.">A good decision, remembered.</p>
		</div>
	)}
	<div class="demo-bottom">
		<button type="button" class="demo-button" data-demo-action data-on-label={control.onLabel}>{control.label}</button>
		<span class="hand demo-status" data-demo-status data-on-status={control.onStatus} aria-live="polite">{control.status}</span>
	</div>
</div>
