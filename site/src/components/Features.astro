---
const groups = [
	{
		heading: "Capture",
		gridClass: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16",
		features: [
			{
				title: "Full Screen Capture",
				description:
					"Press ⇧⌘3 to instantly capture the entire screen where your cursor is. Flash animation confirms the capture.",
				icon: `<rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="2"/><line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" stroke-width="2"/>`,
			},
			{
				title: "Area Selection",
				description:
					"Click and drag to capture exactly what you need. Real-time dimensions display as you select.",
				icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="4 2"/>`,
			},
			{
				title: "Window Capture",
				description:
					"Press ⇧⌘4, then Space, and click a window to capture just that window — no careful dragging needed.",
				icon: `<rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="2"/><circle cx="6.5" cy="6.5" r="0.5" stroke="currentColor" stroke-width="2"/><circle cx="9.5" cy="6.5" r="0.5" stroke="currentColor" stroke-width="2"/>`,
			},
			{
				title: "Multi-Monitor",
				description:
					"All screens dim simultaneously. Capture from whichever display your cursor is on.",
				icon: `<rect x="1" y="4" width="9" height="7" rx="1" stroke="currentColor" stroke-width="2" fill="none"/><rect x="14" y="4" width="9" height="7" rx="1" stroke="currentColor" stroke-width="2" fill="none"/><line x1="5.5" y1="11" x2="5.5" y2="14" stroke="currentColor" stroke-width="2"/><line x1="18.5" y1="11" x2="18.5" y2="14" stroke="currentColor" stroke-width="2"/>`,
			},
			{
				title: "Auto-Save & Clipboard",
				description:
					"Screenshots saved as PNG to ~/Screenshots/ with timestamped filenames — and instantly copied to your clipboard.",
				icon: `<path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" stroke="currentColor" stroke-width="2" fill="none"/><polyline points="17 21 17 13 7 13 7 21" stroke="currentColor" stroke-width="2" fill="none"/>`,
			},
			{
				title: "Thumbnail Preview",
				description:
					"Floating preview appears after capture. Stack up to 5 thumbnails. Click any to annotate. Combine screenshots into one!",
				icon: `<rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="8.5" cy="8.5" r="2.5" stroke="currentColor" stroke-width="2" fill="none"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="2" fill="none"/>`,
			},
			{
				title: "Freehand Annotation",
				description:
					"Draw directly on your screenshots. Undo support included. Saves over the original file.",
				icon: `<path d="M12 19l7-7 3 3-7 7-3-3z" stroke="currentColor" stroke-width="2" fill="none"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" stroke="currentColor" stroke-width="2" fill="none"/><path d="M2 2l7.586 7.586" stroke="currentColor" stroke-width="2"/><circle cx="11" cy="11" r="2" stroke="currentColor" stroke-width="2" fill="none"/>`,
			},
			{
				title: "Delete in One Click",
				description:
					"Trash a bad shot straight from the thumbnail or the editor. The file is removed and the clipboard cleared.",
				icon: `<polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="2" fill="none"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" stroke="currentColor" stroke-width="2" fill="none"/><path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="2"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" stroke="currentColor" stroke-width="2" fill="none"/>`,
			},
		],
	},
	{
		heading: "Desktop Utilities",
		gridClass: "grid grid-cols-1 md:grid-cols-2 gap-6",
		features: [
			{
				title: "Window Tiling",
				description:
					"Ctrl+Opt+← / → snaps the active window to half the screen. Ctrl+Opt+Return maximizes — press again to restore. Leaves room for Stage Manager when it's on, and can be switched off entirely.",
				icon: `<rect x="3" y="4" width="8" height="16" rx="1" stroke="currentColor" stroke-width="2" fill="none"/><rect x="13" y="4" width="8" height="16" rx="1" stroke="currentColor" stroke-width="2" fill="none"/>`,
			},
			{
				title: "Keep Awake",
				description:
					"Stop your Mac from sleeping while a long task runs — an overnight build, an AI agent, a download. Pick 30 minutes to 4 hours, or until you turn it off. The display can still sleep, so you're not burning the screen.",
				icon: `<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke="currentColor" stroke-width="2" fill="none"/><line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2"/>`,
			},
		],
	},
];
---
<section class="py-24 px-6" data-animate="features">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-100">Everything you need</h2>
    <p class="text-gray-400 text-center mb-16 max-w-xl mx-auto">Capture tools that beat the defaults, plus window tiling and keep-awake — all from one menu bar icon.</p>

    {groups.map((g) => (
      <>
        <h3 class="text-sm font-mono tracking-widest uppercase text-accent-light mb-6">{g.heading}</h3>
        <div class={g.gridClass}>
          {g.features.map((f) => (
            <div class="p-6 rounded-2xl bg-surface-50 border border-surface-200 hover:border-accent/30 transition-colors opacity-0" data-animate="feature-card">
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-4 text-accent-light">
                <svg class="w-6 h-6" viewBox="0 0 24 24" set:html={f.icon} />
              </div>
              <h4 class="text-lg font-semibold text-gray-100 mb-2">{f.title}</h4>
              <p class="text-sm text-gray-400 leading-relaxed">{f.description}</p>
            </div>
          ))}
        </div>
      </>
    ))}
  </div>
</section>
