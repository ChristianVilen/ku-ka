---
import { pieceArt } from "../art/pieces";
import { tools } from "../data/tools";
import Keys from "./Keys.astro";
---
<section id="tools" class="section split page-width" aria-labelledby="tools-heading">
	<div class="section-heading sticky-heading">
		<p class="hand kicker">the ingredients</p>
		<h2 id="tools-heading">Five tools. One small home.</h2>
		<p>Turn on the tools you want. Leave the rest off.</p>
	</div>
	<div>
		<ul class="tool-list">
			{tools.map((tool) => (
				<li class="tool-row" id={`tool-${tool.id}`}>
					<span class="tool-art" set:html={pieceArt(tool.id)} />
					<div class="tool-text">
						<h3>{tool.name}</h3>
						<p>{tool.description}</p>
					</div>
					<Keys tool={tool} />
				</li>
			))}
		</ul>
		<aside class="privacy-note paper-note" aria-labelledby="privacy-heading">
			<h3 id="privacy-heading">Your audio stays on your Mac.</h3>
			<p>Meeting transcription runs locally. For AI summaries, Mysli sends the transcript and your typed notes to your chosen provider through Antigravity or Claude Code. If you add a meeting-context file, it goes too. Screenshot attachments stay on your Mac.</p>
		</aside>
	</div>
</section>
