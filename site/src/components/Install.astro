---
import CommandBlock from "./CommandBlock.astro";

const brewCommands =
	"brew tap ChristianVilen/mysli\nbrew trust --cask christianvilen/mysli/mysli\nbrew install --cask mysli";
---
<section id="install" class="install-band" aria-labelledby="install-heading">
	<div class="split page-width">
		<div class="section-heading">
			<p class="hand kicker">getting started</p>
			<h2 id="install-heading">Make yourself at home.</h2>
			<p>Install with Homebrew or <a class="text-link" href="https://github.com/ChristianVilen/mysli/releases/latest">download the latest release</a>.</p>
			<p class="fine-print">Requires macOS 26 or later.</p>
		</div>
		<div class="install-body">
			<CommandBlock label="Homebrew" command={brewCommands} />
			<div class="setup-guide">
				<h3>A short setup. Your choice of tools.</h3>
				<p>Mysli is unsigned. If macOS blocks the first launch, open System Settings, then Privacy &amp; Security, and choose Open Anyway.</p>
				<ol class="setup-steps">
					<li><strong>Welcome.</strong> Open Mysli and choose Get Started.</li>
					<li><strong>Choose your tools.</strong> Keep the ones you want. Calendar reminders are a separate option under Meetings.</li>
					<li><strong>Allow access.</strong> Setup shows the permissions your choices need. You can finish now and allow missing access later.</li>
				</ol>
			</div>
		</div>
	</div>
</section>
