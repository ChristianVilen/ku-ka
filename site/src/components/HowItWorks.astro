---
const stages = [
	{
		num: "1.0",
		title: "Press.",
		body: "⇧⌘3 captures the whole screen where your cursor is. ⇧⌘4 starts a selection, or tap Space and click a window to grab just that window.",
	},
	{
		num: "2.0",
		title: "Select.",
		body: "Drag across exactly what you need. Every screen dims, and the selection's dimensions read out live as you move.",
	},
	{
		num: "3.0",
		title: "Saved.",
		body: "The capture lands in ~/Screenshots/ as a timestamped PNG, and it's already on your clipboard.",
	},
	{
		num: "4.0",
		title: "Annotate, or delete.",
		body: "A thumbnail floats in the corner. Stack up to five, click one to draw on it, combine them into a single image, or trash a bad shot and clear the clipboard with it.",
	},
];
---
<section class="px-6 py-28">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-display text-[clamp(1.85rem,3vw+0.5rem,2.75rem)] font-medium tracking-[-0.02em] text-ink">
      From keypress to clipboard.
    </h2>

    <ol class="mt-14">
      {stages.map((s) => (
        <li class="border-t border-rule pb-10 pt-7 last:pb-0">
          <span class="mono-label !text-accent" aria-hidden="true">{s.num}</span>
          <h3 class="mt-2 font-display text-xl font-medium text-ink">{s.title}</h3>
          <p class="mt-2 max-w-[55ch] text-neutral">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
