---
import "../styles/global.css";

interface Props {
	title?: string;
}
const { title = "Ku-Ka · Screenshots. Tiling. Keep awake." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A lightweight macOS menu bar toolkit: a better Shift+Cmd+3/4 screenshot tool, window tiling hotkeys, and a keep-awake timer for long-running tasks." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <slot />
    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>
