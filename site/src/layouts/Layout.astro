---
import { Font } from "astro:assets";
import "../styles/global.css";
import { appIcon } from "../data/site";

interface Props {
	title?: string;
}
const { title = "Mysli - A daily mix of Mac tools." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Screenshots, clipboard history, window tiling, Keep Awake and private meeting notes, in one menu bar app." />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17191a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={appIcon} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-caveat" preload />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/copy.ts';
    </script>
  </body>
</html>
